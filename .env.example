# ── Keygen ────────────────────────────────────────────────
KEYGEN_ACCOUNT_ID=
KEYGEN_POLICY_ID=
KEYGEN_API_TOKEN=

# ── Admin auth ───────────────────────────────────────────
# Used to sign admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_API_SECRET=

# Seed admin login (only used the first time the DB is created)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── App ──────────────────────────────────────────────────
APP_VERSION=1.0.0
SERVER_PORT=4001
CLIENT_ORIGIN=http://localhost:5173

# ── Paths ────────────────────────────────────────────────
INSTALLERS_DIR=./installers
LOGS_DIR=./logs
DB_PATH=./server/data/fulfillment.db
