{
  "name": "usb-fulfillment-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Internal USB fulfillment tool for Credit Analyzer license + USB preparation",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "usb:dev": "concurrently -n SERVER,CLIENT -c yellow,cyan \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite",
    "usb:build": "vite build",
    "usb:prepare": "node server/scripts/checkInstallers.js",
    "mac:dev": "npm run usb:build && env -u ELECTRON_RUN_AS_NODE electron .",
    "mac:build": "npm run usb:build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "better-sqlite3": "^11.3.0",
    "drivelist": "^11.0.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "uuid": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "lucide-react": "^0.383.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.creditanalyzer.usbkey",
    "productName": "Credit Analyzer USB Key",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/drivelist/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "installers",
        "to": "installers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
